<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.rounding</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='point_of_sale']" position="inside">
                <h2>Rounding Product Selling Prices in POS</h2>
                <div class="row mt16 o_settings_container" id="rounding_product_selling_prices">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_enable_rounding_price"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_enable_rounding_price" string="Enable Rounding Product Selling Price"/>
                            <div class="text-muted">
                                Enable rounding of product prices in POS
                            </div>
                            <div class="content-group" attrs="{'invisible': [('pos_enable_rounding_price', '=', False)]}">
                                <div class="mt16">
                                    <label for="pos_rounding_value" string="Enter Rounding Value" class="col-lg-3 o_light_label"/>
                                    <field name="pos_rounding_value"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" attrs="{'invisible': [('pos_enable_rounding_price', '=', False)]}">
                        <div class="o_setting_left_pane">
                            <field name="pos_enable_cashier_rounding"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_enable_cashier_rounding" string="Only Certain Cashiers Can Use Rounded Prices"/>
                            <div class="text-muted">
                                Only Certain Cashiers Can Use Rounded Prices in POS
                            </div>
                            <div class="content-group" attrs="{'invisible': [('pos_enable_cashier_rounding', '=', False)]}">
                                <div class="mt16">
                                    <field name="pos_rounding_cashier_ids" widget="many2many_tags" placeholder="Select Cashiers"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
